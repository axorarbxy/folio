# Folio ML Environment Configuration
# Options for FOLIO_MODE: fake | replay | live
FOLIO_MODE=fake

FOLIO_API_HOST=0.0.0.0
FOLIO_API_PORT=8000
FOLIO_LOG_LEVEL=INFO
FOLIO_CORS_ORIGINS=["http://localhost:3000"]

# LLM Providers (optional in fake/replay mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security & Privacy
FOLIO_REDACT_PII=true
